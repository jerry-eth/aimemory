<Page x:Class="AiMemoryManager.Views.LlmSettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:services="clr-namespace:AiMemoryManager.Services"
      Title="{Binding [Nav.Llm], Source={x:Static services:Locator.L10n}}">
    <Grid>
        <TextBlock Text="{Binding [Nav.Llm], Source={x:Static services:Locator.L10n}}"
                   FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>
</Page>
