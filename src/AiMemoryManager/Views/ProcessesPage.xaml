<Page x:Class="AiMemoryManager.Views.ProcessesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:AiMemoryManager.ViewModels"
      xmlns:services="clr-namespace:AiMemoryManager.Services"
      Title="{Binding [Nav.Processes], Source={x:Static services:Locator.L10n}}">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Page.Resources>
    <Page.DataContext>
        <vm:ProcessesViewModel/>
    </Page.DataContext>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- 操作条:手动刷新 + 实时监控状态 + 结束选中 -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ui:Button Content="{Binding [Processes.Refresh], Source={x:Static services:Locator.L10n}}"
                       Command="{Binding RefreshCommand}"/>
            <ui:Button Grid.Column="1" Content="{Binding [L3.Terminate], Source={x:Static services:Locator.L10n}}"
                       Appearance="Danger" Command="{Binding TerminateSelectedCommand}" Margin="8,0,0,0"/>
            <StackPanel Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding LiveSummaryText}"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <TextBlock Text="{Binding StatusText}"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </Grid>
        <!-- WPF-UI 4.3.0 不为原生 DataGrid 提供主题,这里只用 DynamicResource 画刷做最低限度适配 -->
        <DataGrid Grid.Row="1" ItemsSource="{Binding Items}" AutoGenerateColumns="False"
                  IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" SelectionUnit="FullRow"
                  HeadersVisibility="Column" GridLinesVisibility="All"
                  Background="{x:Null}" BorderThickness="0"
                  RowBackground="{x:Null}" AlternatingRowBackground="{x:Null}"
                  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                  HorizontalGridLinesBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                   VerticalGridLinesBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  ScrollViewer.CanContentScroll="True"
                  EnableRowVirtualization="True"
                  EnableColumnVirtualization="True"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  Margin="0,12,0,0">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <Setter Property="Padding" Value="8,4"/>
                     <Setter Property="HorizontalContentAlignment" Value="Left"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <!-- 系统关键进程整行灰显 -->
                        <DataTrigger Binding="{Binding IsCritical}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <!-- ContextMenu 不在可视树内,须经 PlacementTarget 取宿主 DataGrid 的 DataContext 与选中行 -->
                    <MenuItem Header="{Binding [Processes.AddWhitelist], Source={x:Static services:Locator.L10n}}"
                              Command="{Binding PlacementTarget.DataContext.AddToWhitelistCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <!-- L3 勾选列:系统关键/白名单/防误杀/前台行(CanKill=false)禁用 -->
                <DataGridTemplateColumn Width="64" MinWidth="64">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsEnabled="{Binding CanKill}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8,0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="{Binding [Processes.Col.Name], Source={x:Static services:Locator.L10n}}"
                                        Width="2*" MinWidth="140">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Name}" Margin="8,0" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="{Binding [Processes.Col.Pid], Source={x:Static services:Locator.L10n}}"
                                    Binding="{Binding Pid}" Width="75" MinWidth="65" IsReadOnly="True"/>
                <DataGridTemplateColumn Header="{Binding [Processes.Col.Memory], Source={x:Static services:Locator.L10n}}"
                                        Width="*" MinWidth="70">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding MemoryText}" HorizontalAlignment="Right"
                                       Margin="8,0" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="{Binding [Processes.Col.Cpu], Source={x:Static services:Locator.L10n}}"
                                        Width="*" MinWidth="70">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding CpuText}" HorizontalAlignment="Right"
                                       Margin="8,0" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="{Binding [Processes.Col.Status], Source={x:Static services:Locator.L10n}}"
                                        Width="*" MinWidth="70">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding StatusText}" Margin="8,0" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="{Binding [Processes.Col.Signature], Source={x:Static services:Locator.L10n}}"
                                        Width="*" MinWidth="90">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding SignatureText}" Margin="8,0" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="{Binding [Processes.Col.Path], Source={x:Static services:Locator.L10n}}"
                                        Width="2*" MinWidth="180">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Path}" Margin="8,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="{Binding [Processes.Col.Whitelist], Source={x:Static services:Locator.L10n}}"
                                        Width="*" MinWidth="90">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsExcluded, Mode=OneWay}"
                                      IsEnabled="{Binding IsNotCritical}"
                                      HorizontalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <!-- FR-2.7 后悔药卡:最近被结束的进程,可一键恢复 -->
        <ui:Card Grid.Row="2" Margin="0,12,0,0">
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="{Binding [L3.UndoTitle], Source={x:Static services:Locator.L10n}}"
                           FontWeight="SemiBold"/>
                <Grid Grid.Row="1" Margin="0,8,0,0">
                    <ListView ItemsSource="{Binding KillLogRecords}" MaxHeight="160"
                              BorderThickness="0" Background="{x:Null}"
                              Visibility="{Binding HasKillLog, Converter={StaticResource BoolToVis}}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Time, StringFormat=MM-dd HH:mm}"
                                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"
                                               Margin="0,0,12,0"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Path}" VerticalAlignment="Center"
                                               Margin="0,0,12,0" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <ui:Button Grid.Column="3"
                                               Content="{Binding [L3.Restore], Source={x:Static services:Locator.L10n}}"
                                               Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                               CommandParameter="{Binding}"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock Text="{Binding [L3.UndoEmpty], Source={x:Static services:Locator.L10n}}"
                               Visibility="{Binding KillLogEmpty, Converter={StaticResource BoolToVis}}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </Grid>
            </Grid>
        </ui:Card>
    </Grid>
</Page>
