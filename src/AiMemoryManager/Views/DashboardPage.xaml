<Page x:Class="AiMemoryManager.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:c="clr-namespace:AiMemoryManager.Controls"
    xmlns:vm="clr-namespace:AiMemoryManager.ViewModels"
    xmlns:services="clr-namespace:AiMemoryManager.Services"
      Title="{Binding [Nav.Dashboard], Source={x:Static services:Locator.L10n}}"
      AutomationProperties.Name="{Binding RelativeSource={RelativeSource Self}, Path=Title}">
    <Page.DataContext>
        <vm:DashboardViewModel/>
    </Page.DataContext>
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Page.Resources>
    <!-- 加了清理历史卡后内容可能超出窗口高度,整体可滚动 -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" CanContentScroll="False" PanningMode="VerticalFirst">
    <StackPanel Margin="24">
        <!-- 英雄区:大圆环 + 主操作 -->
        <Grid Margin="0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid Width="180" Height="180">
                <c:PercentageRing Percent="{Binding Percent}" AnimationsEnabled="{Binding AnimationsEnabled}" StrokeThickness="12"
                                  RingBrush="{DynamicResource SystemFillColorAttentionBrush}"
                                  TrackBrush="{DynamicResource TextFillColorSecondaryBrush}"/>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Percent, StringFormat=F0}" FontSize="40"
                               FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding [Dashboard.UsedMemory], Source={x:Static services:Locator.L10n}}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
            <!-- AsyncRelayCommand 执行期间 CanExecute 自动为 false,按钮自动禁用,无需 InverseBool 转换器 -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="32,0,0,0">
                <ui:Button Content="{Binding [Dashboard.CleanL1], Source={x:Static services:Locator.L10n}}"
                           Appearance="Primary" Command="{Binding CleanL1Command}"
                           Width="200" Height="40"/>
                <ui:Button Content="{Binding [Dashboard.CleanL2], Source={x:Static services:Locator.L10n}}"
                           Command="{Binding CleanL2Command}" Margin="0,12,0,0" Width="200"/>
                <TextBlock Text="{Binding LastCleanText}" Margin="0,12,0,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </Grid>
        <!-- 信息卡片行 -->
        <UniformGrid Columns="3" Margin="0,12">
            <ui:Card Margin="0,0,8,0">
                <StackPanel Margin="16">
                    <TextBlock Text="{Binding [Dashboard.Total], Source={x:Static services:Locator.L10n}}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="{Binding TotalText}" FontSize="24" FontWeight="SemiBold"/>
                </StackPanel>
            </ui:Card>
            <ui:Card Margin="4,0">
                <StackPanel Margin="16">
                    <TextBlock Text="{Binding [Dashboard.Available], Source={x:Static services:Locator.L10n}}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="{Binding AvailableText}" FontSize="24" FontWeight="SemiBold"/>
                </StackPanel>
            </ui:Card>
            <ui:Card Margin="8,0,0,0">
                <StackPanel Margin="16">
                    <TextBlock Text="{Binding [Dashboard.Used], Source={x:Static services:Locator.L10n}}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="{Binding UsedText}" FontSize="24" FontWeight="SemiBold"/>
                </StackPanel>
            </ui:Card>
        </UniformGrid>
        <!-- 迷你曲线(最近 5 分钟,150 个采样点) -->
        <ui:Card Margin="0,4">
            <StackPanel Margin="16">
                <TextBlock Text="{Binding [Dashboard.Timeline], Source={x:Static services:Locator.L10n}}"
                           FontWeight="SemiBold"/>
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="60"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Polyline x:Name="MiniChart" Stretch="Fill"
                              Stroke="{DynamicResource SystemFillColorAttentionBrush}" StrokeThickness="2"/>
                    <UniformGrid x:Name="TimelineLabels" Grid.Row="1" Rows="1" Columns="5" Margin="0,4,0,0"/>
                </Grid>
            </StackPanel>
        </ui:Card>        <!-- 清理历史卡(最新 10 条:时间/级别/释放/触发方式) -->
        <ui:Card Margin="0,4">
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="{Binding [Dash.History], Source={x:Static services:Locator.L10n}}"
                           FontWeight="SemiBold"/>
                <Grid Grid.Row="1" Margin="0,8,0,0">
                    <ListView ItemsSource="{Binding HistoryRows}" MaxHeight="260"
                              BorderThickness="0" Background="{x:Null}"
                              Visibility="{Binding HasHistory, Converter={StaticResource BoolToVis}}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding TimeText}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding LevelText}" VerticalAlignment="Center"
                                               Margin="0,0,16,0"/>
                                    <TextBlock Grid.Column="2" Text="{Binding FreedText}" VerticalAlignment="Center"
                                               Margin="0,0,16,0"/>
                                    <TextBlock Grid.Column="3" Text="{Binding TriggerText}" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock Text="{Binding [Dash.HistoryEmpty], Source={x:Static services:Locator.L10n}}"
                               Visibility="{Binding HistoryEmpty, Converter={StaticResource BoolToVis}}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </Grid>
            </Grid>
        </ui:Card>
    </StackPanel>
    </ScrollViewer>
</Page>
