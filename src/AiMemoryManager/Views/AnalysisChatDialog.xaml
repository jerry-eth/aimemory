<ui:FluentWindow x:Class="AiMemoryManager.Views.AnalysisChatDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:services="clr-namespace:AiMemoryManager.Services"
        Title="{Binding [Analysis.ChatTitle], Source={x:Static services:Locator.L10n}}"
        Width="760" Height="620" MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterOwner" WindowBackdropType="None">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="MessagesList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="12" Margin="0,4" CornerRadius="6"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                            <StackPanel>
                                <TextBlock Text="{Binding Role}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Content}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <Border x:Name="PlanPanel" Grid.Row="1" Padding="12" Margin="0,8,0,8"
                Visibility="Collapsed" BorderThickness="1" CornerRadius="6"
                BorderBrush="{DynamicResource SystemFillColorCautionBrush}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding [Analysis.ChatPlan], Source={x:Static services:Locator.L10n}}" FontWeight="SemiBold"/>
                    <TextBlock x:Name="PlanText" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding [Analysis.ChatConfirm], Source={x:Static services:Locator.L10n}}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                <ui:Button Grid.Column="1" Content="{Binding [Analysis.ChatExecute], Source={x:Static services:Locator.L10n}}"
                           Appearance="Primary" Click="OnExecutePlan" MinWidth="110" VerticalAlignment="Center"/>
            </Grid>
        </Border>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="InputBox" MinHeight="42" AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" KeyDown="OnInputKeyDown"
                     ToolTip="{Binding [Analysis.ChatPlaceholder], Source={x:Static services:Locator.L10n}}"/>
            <ui:Button Grid.Column="1" Content="{Binding [Analysis.ChatSend], Source={x:Static services:Locator.L10n}}"
                       Click="OnSend" Appearance="Primary" MinWidth="90" Margin="8,0,0,0"/>
        </Grid>
    </Grid>
</ui:FluentWindow>
