<Page x:Class="AiMemoryManager.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:AiMemoryManager.ViewModels"
      xmlns:services="clr-namespace:AiMemoryManager.Services"
      Title="{Binding [Nav.Settings], Source={x:Static services:Locator.L10n}}">
    <Page.DataContext>
        <vm:SettingsViewModel/>
    </Page.DataContext>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <!-- 语言卡 -->
            <ui:Card Margin="0,4">
                <Grid Margin="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding [Settings.Language], Source={x:Static services:Locator.L10n}}"
                               VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" Width="160"
                              SelectedIndex="{Binding LanguageIndex}">
                        <ComboBoxItem Content="{Binding [Settings.LangAuto], Source={x:Static services:Locator.L10n}}"/>
                        <ComboBoxItem Content="中文"/>
                        <ComboBoxItem Content="English"/>
                    </ComboBox>
                </Grid>
            </ui:Card>
            <!-- 动效卡 -->
            <ui:Card Margin="0,4">
                <Grid Margin="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding [Settings.Animations], Source={x:Static services:Locator.L10n}}"
                               VerticalAlignment="Center"/>
                    <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding Animations}"/>
                </Grid>
            </ui:Card>
            <!-- 关于卡 -->
            <ui:Card Margin="0,4">
                <StackPanel Margin="16">
                    <TextBlock Text="{Binding [Settings.About], Source={x:Static services:Locator.L10n}}"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding [App.Title], Source={x:Static services:Locator.L10n}}"
                               Margin="0,8,0,0"/>
                    <TextBlock Text="{Binding VersionText}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</Page>
