<Page x:Class="AiMemoryManager.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:AiMemoryManager.ViewModels"
      xmlns:services="clr-namespace:AiMemoryManager.Services"
      Title="{Binding [Nav.Settings], Source={x:Static services:Locator.L10n}}"
      AutomationProperties.Name="{Binding RelativeSource={RelativeSource Self}, Path=Title}">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Page.Resources>
    <Page.DataContext>
        <vm:SettingsViewModel/>
    </Page.DataContext>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" CanContentScroll="False" PanningMode="VerticalFirst">
        <StackPanel Margin="24">
            <!-- 语言卡 -->
            <ui:Card Margin="0,4">
                <Grid Margin="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding [Settings.Language], Source={x:Static services:Locator.L10n}}"
                               VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" Width="160"
                              SelectedIndex="{Binding LanguageIndex}">
                        <ComboBoxItem Content="{Binding [Settings.LangAuto], Source={x:Static services:Locator.L10n}}"/>
                        <ComboBoxItem Content="中文"/>
                        <ComboBoxItem Content="English"/>
                    </ComboBox>
                </Grid>
            </ui:Card>
            <!-- 动效卡 -->
            <ui:Card Margin="0,4">
                <Grid Margin="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding [Settings.Animations], Source={x:Static services:Locator.L10n}}"
                               VerticalAlignment="Center"/>
                    <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding Animations}"/>
                </Grid>
            </ui:Card>
            <!-- 开机自启卡 -->
            <ui:Card Margin="0,4">
                <Grid Margin="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding [Settings.AutoStart], Source={x:Static services:Locator.L10n}}"/>
                        <TextBlock Text="{Binding [Settings.AutoStartDesc], Source={x:Static services:Locator.L10n}}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   FontSize="12" Margin="0,2,0,0"/>
                    </StackPanel>
                    <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoStartEnabled}"/>
                </Grid>
            </ui:Card>
            <!-- 通知卡 -->
            <ui:Card Margin="0,4">
                <Grid Margin="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding [Settings.Notifications], Source={x:Static services:Locator.L10n}}"/>
                        <TextBlock Text="{Binding [Settings.NotificationsDesc], Source={x:Static services:Locator.L10n}}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   FontSize="12" Margin="0,2,0,0"/>
                    </StackPanel>
                    <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding NotificationsEnabled}"/>
                </Grid>
            </ui:Card>
            <!-- 全局热键卡 -->
            <ui:Card Margin="0,4">
                <Grid Margin="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding [Settings.Hotkey], Source={x:Static services:Locator.L10n}}"/>
                        <TextBlock Text="{Binding [Settings.HotkeyHint], Source={x:Static services:Locator.L10n}}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   FontSize="12" Margin="0,2,0,0"/>
                        <TextBlock Text="{Binding [Settings.HotkeyFail], Source={x:Static services:Locator.L10n}}"
                                   Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                   FontSize="12" Margin="0,2,0,0"
                                   Visibility="{Binding HotkeyFailed, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                    <TextBox Grid.Column="1" Width="160" IsReadOnly="True" Text="{Binding HotkeyText, Mode=OneWay}"
                             VerticalContentAlignment="Center"
                             PreviewKeyDown="OnHotkeyPreviewKeyDown"/>
                </Grid>
            </ui:Card>
            <!-- 关于卡 -->
            <ui:Card Margin="0,4">
                <StackPanel Margin="16">
                    <TextBlock Text="{Binding [Settings.About], Source={x:Static services:Locator.L10n}}"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding [App.Title], Source={x:Static services:Locator.L10n}}"
                               Margin="0,8,0,0"/>
                    <TextBlock Text="{Binding VersionText}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</Page>
