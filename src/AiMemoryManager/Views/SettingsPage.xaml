<Page x:Class="AiMemoryManager.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:services="clr-namespace:AiMemoryManager.Services"
      Title="{Binding [Nav.Settings], Source={x:Static services:Locator.L10n}}">
    <Grid>
        <TextBlock Text="{Binding [Nav.Settings], Source={x:Static services:Locator.L10n}}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="24"/>
    </Grid>
</Page>
