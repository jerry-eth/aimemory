<ui:FluentWindow x:Class="AiMemoryManager.Views.SlimConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:services="clr-namespace:AiMemoryManager.Services"
        Width="520" SizeToContent="Height" MinHeight="160"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowBackdropType="None">
    <!-- FR-12 通用确认对话框(照 Task 7 TerminateConfirmDialog 先例:FluentWindow + ShowDialog)。
         标题/正文/确认按钮文案全部由调用方传入,正文含各操作的风险警告。 -->
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="MessageText" TextWrapping="Wrap"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <ui:Button Content="{Binding [L3.Cancel], Source={x:Static services:Locator.L10n}}"
                       Click="OnCancel" MinWidth="88"/>
            <ui:Button x:Name="ConfirmButton" Appearance="Danger"
                       Click="OnConfirm" MinWidth="88" Margin="8,0,0,0"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
