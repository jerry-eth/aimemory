<Page x:Class="AiMemoryManager.Views.SmartAnalysisPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:conv="clr-namespace:AiMemoryManager.Converters"
      xmlns:services="clr-namespace:AiMemoryManager.Services"
      Title="{Binding [Nav.Analysis], Source={x:Static services:Locator.L10n}}">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
    </Page.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" CanContentScroll="False" PanningMode="VerticalFirst">
        <StackPanel Margin="24" HorizontalAlignment="Stretch">
            <!-- 顶部操作条:开始分析 + 状态 + Token 用量(AsyncRelayCommand 执行中自动禁用按钮) -->
            <ui:Card Margin="0,4">
                <WrapPanel Margin="16" Orientation="Horizontal">
                    <ui:Button Content="{Binding [Analysis.Run], Source={x:Static services:Locator.L10n}}"
                               Appearance="Primary" Command="{Binding RunAnalysisCommand}"
                               Width="160" Height="40"/>
                    <!-- 有结果后显示:跳过缓存重新请求 -->
                    <ui:Button Content="{Binding [Analysis.ForceRefresh], Source={x:Static services:Locator.L10n}}"
                               Appearance="Secondary" Command="{Binding ForceRefreshCommand}"
                               Width="120" Height="40" Margin="8,0,0,0"
                               Visibility="{Binding HasSuggestions, Converter={StaticResource BoolToVis}}"/>
                    <StackPanel VerticalAlignment="Center" Margin="16,0,0,0">
                        <TextBlock Text="{Binding StatusText}"/>
                        <TextBlock Text="{Binding UsageText}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </WrapPanel>
            </ui:Card>            <!-- 统一的大模型对话区：报告、历史消息和执行确认都在当前页面内 -->
            <ui:Card Margin="0,4" Visibility="{Binding HasReport, Converter={StaticResource BoolToVis}}">
                <StackPanel Margin="16">
                    <TextBlock Text="{Binding [Analysis.ChatTitle], Source={x:Static services:Locator.L10n}}"
                               FontWeight="SemiBold" FontSize="16"/>
                    <ui:Card Margin="0,8,0,4">
                        <StackPanel Margin="12">
                            <TextBlock Text="{Binding [Analysis.ReportTitle], Source={x:Static services:Locator.L10n}}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Report.Summary}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            <WrapPanel Margin="0,6,0,0">
                                <TextBlock Text="{Binding [Analysis.ReportMemory], Source={x:Static services:Locator.L10n}}" FontWeight="SemiBold"/>
                                <TextBlock Text="："/><TextBlock Text="{Binding Report.MemoryText}" Margin="0,0,16,0"/>
                                <TextBlock Text="{Binding [Analysis.ReportProcesses], Source={x:Static services:Locator.L10n}}" FontWeight="SemiBold"/>
                                <TextBlock Text="："/><TextBlock Text="{Binding Report.ProcessCount}" Margin="0,0,16,0"/>
                                <TextBlock Text="{Binding [Analysis.ReportSuggestions], Source={x:Static services:Locator.L10n}}" FontWeight="SemiBold"/>
                                <TextBlock Text="："/><TextBlock Text="{Binding Report.SuggestionCount}"/>
                            </WrapPanel>
                            <ItemsControl ItemsSource="{Binding Report.Recommendations}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </ui:Card>
                    <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                        <ItemsControl ItemsSource="{Binding ChatMessages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10" Margin="0,3" CornerRadius="6">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Role}" FontWeight="SemiBold" FontSize="12"/>
                                            <TextBlock Text="{Binding Content}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Border Padding="10" Margin="0,8,0,4" BorderThickness="1" CornerRadius="6"
                            BorderBrush="{DynamicResource SystemFillColorCautionBrush}"
                            Visibility="{Binding HasPendingChatPlan, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="0"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding [Analysis.ChatPlan], Source={x:Static services:Locator.L10n}}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding ChatPlanText}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                <TextBlock Text="{Binding [Analysis.ChatConfirm], Source={x:Static services:Locator.L10n}}"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <ui:Button Grid.Column="1" Content="{Binding [Analysis.ChatExecute], Source={x:Static services:Locator.L10n}}"
                                       Command="{Binding ExecuteChatPlanCommand}" Appearance="Primary" MinWidth="96" Padding="8,4"
                                       VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </Grid>
                    </Border>
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="0"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox Text="{Binding ChatInput, UpdateSourceTrigger=PropertyChanged}" MinHeight="42" MinWidth="0"
                                 AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 ToolTip="{Binding [Analysis.ChatPlaceholder], Source={x:Static services:Locator.L10n}}"/>
                        <ui:Button Grid.Column="1" Content="{Binding [Analysis.ChatSend], Source={x:Static services:Locator.L10n}}"
                                   Command="{Binding SendChatCommand}" Appearance="Primary" MinWidth="82" Padding="8,4" Margin="8,0,0,0"/>
                    </Grid>
                </StackPanel>
            </ui:Card>            <!-- 无档案引导卡 -->
            <ui:Card Margin="0,4"
                     Visibility="{Binding HasProfile, Converter={StaticResource InverseBoolToVis}}">
                <TextBlock Margin="16" Text="{Binding [Analysis.NoProfile], Source={x:Static services:Locator.L10n}}"
                           Foreground="{DynamicResource SystemFillColorCautionBrush}" FontWeight="SemiBold"/>
            </ui:Card>
            <!-- 建议列表:每条建议一张卡 -->
            <ItemsControl ItemsSource="{Binding Suggestions}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:Card Margin="0,4">
                            <Grid Margin="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding ProcessName}" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                        <!-- 风险徽章:按 Risk 上绿/橙/红 -->
                                        <Border Margin="8,0,0,0" Padding="8,2" CornerRadius="4">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Risk}" Value="low">
                                                            <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Risk}" Value="medium">
                                                            <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Risk}" Value="high">
                                                            <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding ActionText}" FontSize="12"
                                                       Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Reason}" TextWrapping="Wrap" Margin="0,4,0,0"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                                <!-- compress 建议:立即压缩(M2=全量 L1);terminate 建议:结束进程(L3 确认流) -->
                                <ui:Button Grid.Column="1" VerticalAlignment="Center"
                                           Content="{Binding [Analysis.CompressNow], Source={x:Static services:Locator.L10n}}"
                                           Command="{Binding DataContext.CompressCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                           CommandParameter="{Binding}"
                                           Visibility="{Binding IsCompress, Converter={StaticResource BoolToVis}}"/>
                                <ui:Button Grid.Column="1" VerticalAlignment="Center"
                                           Content="{Binding [Analysis.TerminateNow], Source={x:Static services:Locator.L10n}}"
                                           Appearance="Secondary"
                                           Command="{Binding DataContext.TerminateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                           CommandParameter="{Binding}"
                                           Visibility="{Binding IsTerminate, Converter={StaticResource BoolToVis}}"/>
                            </Grid>
                        </ui:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <!-- 泄漏告警卡 -->
            <ui:Card Margin="0,4">
                <StackPanel Margin="16">
                    <TextBlock Text="{Binding [Leak.Title], Source={x:Static services:Locator.L10n}}"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding [Leak.Empty], Source={x:Static services:Locator.L10n}}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,8,0,0"
                               Visibility="{Binding HasLeakAlerts, Converter={StaticResource InverseBoolToVis}}"/>
                    <ItemsControl ItemsSource="{Binding LeakAlerts}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding ProcessName}" FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Margin="12,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource SystemFillColorCriticalBrush}">
                                        <Run Text="+"/><Run Text="{Binding GrowthMb}"/><Run Text="MB"/>
                                    </TextBlock>
                                    <TextBlock Grid.Column="2" Margin="12,0,0,0" Text="{Binding TimeText}"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <!-- FR-11.2:泄漏告警一键分析(Leak 触发器,结果走既有填充路径) -->
                                    <ui:Button Grid.Column="3" Margin="12,0,0,0"
                                               Content="{Binding [Leak.Analyze], Source={x:Static services:Locator.L10n}}"
                                               Command="{Binding DataContext.AnalyzeLeakCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</Page>
