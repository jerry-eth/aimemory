<Page x:Class="AiMemoryManager.Views.CSlimPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:conv="clr-namespace:AiMemoryManager.Converters"
      xmlns:services="clr-namespace:AiMemoryManager.Services"
      Title="{Binding [Nav.CSlim], Source={x:Static services:Locator.L10n}}">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>
        <!-- WPF-UI 4.3.0 不为原生 DataGrid 提供主题,沿用 TokenStatsPage 的最低限度适配 -->
        <Style x:Key="SlimGridHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
        <Style x:Key="SlimCellText" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,0"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SlimGrid" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="Background" Value="{x:Null}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowBackground" Value="{x:Null}"/>
            <Setter Property="AlternatingRowBackground" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}"/>
            <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource SlimGridHeader}"/>
        </Style>
        <!-- 勾选列模板:两张建议表共用 -->
        <DataTemplate x:Key="SelectCell">
            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </DataTemplate>
    </Page.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" CanContentScroll="False" PanningMode="VerticalFirst">
        <StackPanel Margin="24" MinWidth="860">
            <!-- ① 扫描结果卡:扫描/LLM 分析按钮 + 状态文本 + 结果表(路径/大小/类别/文件数) -->
            <ui:Card Margin="0,4">
                <StackPanel Margin="16">
                    <StackPanel Orientation="Horizontal">
                        <ui:Button Content="{Binding [Slim.Scan], Source={x:Static services:Locator.L10n}}"
                                   Command="{Binding ScanCommand}"/>
                        <ui:Button Content="{Binding [Slim.Analyze], Source={x:Static services:Locator.L10n}}"
                                   Command="{Binding AnalyzeCommand}" Margin="8,0,0,0"/>
                        <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Margin="12,0,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <TextBlock Text="{Binding [Slim.Empty], Source={x:Static services:Locator.L10n}}"
                               Margin="0,8,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Visibility="{Binding HasScanResults, Converter={StaticResource InvBoolToVis}}"/>
                    <DataGrid Style="{StaticResource SlimGrid}" ItemsSource="{Binding ScanResults}"
                              MaxHeight="320" Margin="0,8,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{Binding [Processes.Col.Path], Source={x:Static services:Locator.L10n}}"
                                                Binding="{Binding Path}" Width="3*" MinWidth="280" ElementStyle="{StaticResource SlimCellText}"/>
                            <DataGridTextColumn Header="{Binding [Slim.Size], Source={x:Static services:Locator.L10n}}"
                                                Binding="{Binding SizeText}" Width="*" MinWidth="100" ElementStyle="{StaticResource SlimCellText}"/>
                            <DataGridTextColumn Header="{Binding [Slim.Category], Source={x:Static services:Locator.L10n}}"
                                                Binding="{Binding Category}" Width="*" MinWidth="120" ElementStyle="{StaticResource SlimCellText}"/>
                            <DataGridTextColumn Header="{Binding [Slim.FileCount], Source={x:Static services:Locator.L10n}}"
                                                Binding="{Binding FileCount}" Width="*" MinWidth="100" ElementStyle="{StaticResource SlimCellText}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </ui:Card>
            <!-- ② LLM 建议-可清理卡:勾选表(路径/理由/预估释放)+ 删除选中 -->
            <ui:Card Margin="0,4">
                <StackPanel Margin="16">
                    <TextBlock Text="{Binding [Slim.Cleanable], Source={x:Static services:Locator.L10n}}"
                               FontWeight="SemiBold"/>
                    <DataGrid Style="{StaticResource SlimGrid}" ItemsSource="{Binding Cleanable}"
                              MaxHeight="240" MinHeight="48" Margin="0,8,0,0">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="40" CellTemplate="{StaticResource SelectCell}"/>
                            <DataGridTextColumn Header="{Binding [Processes.Col.Path], Source={x:Static services:Locator.L10n}}"
                                                Binding="{Binding Path}" Width="3*" MinWidth="280" ElementStyle="{StaticResource SlimCellText}"/>
                            <DataGridTextColumn Header="{Binding [Slim.Reason], Source={x:Static services:Locator.L10n}}"
                                                Binding="{Binding Reason}" Width="2*" MinWidth="220" ElementStyle="{StaticResource SlimCellText}"/>
                            <DataGridTextColumn Header="{Binding [Slim.EstFree], Source={x:Static services:Locator.L10n}}"
                                                Binding="{Binding EstText}" Width="*" MinWidth="130" ElementStyle="{StaticResource SlimCellText}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <ui:Button Content="{Binding [Slim.DeleteSelected], Source={x:Static services:Locator.L10n}}"
                               Appearance="Danger" Command="{Binding DeleteSelectedCommand}"
                               HorizontalAlignment="Left" Margin="0,8,0,0"/>
                </StackPanel>
            </ui:Card>
            <!-- ③ LLM 建议-可迁移卡:勾选表(路径/理由/目标盘)+ 迁移选中 -->
            <ui:Card Margin="0,4">
                <StackPanel Margin="16">
                    <TextBlock Text="{Binding [Slim.Migratable], Source={x:Static services:Locator.L10n}}"
                               FontWeight="SemiBold"/>
                    <DataGrid Style="{StaticResource SlimGrid}" ItemsSource="{Binding Migratable}"
                              MaxHeight="240" MinHeight="48" Margin="0,8,0,0">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="40" CellTemplate="{StaticResource SelectCell}"/>
                            <DataGridTextColumn Header="{Binding [Processes.Col.Path], Source={x:Static services:Locator.L10n}}"
                                                Binding="{Binding Path}" Width="3*" MinWidth="280" ElementStyle="{StaticResource SlimCellText}"/>
                            <DataGridTextColumn Header="{Binding [Slim.Reason], Source={x:Static services:Locator.L10n}}"
                                                Binding="{Binding Reason}" Width="2*" MinWidth="220" ElementStyle="{StaticResource SlimCellText}"/>
                            <DataGridTextColumn Header="{Binding [Slim.TargetDrive], Source={x:Static services:Locator.L10n}}"
                                                Binding="{Binding TargetDrive}" Width="*" MinWidth="130" ElementStyle="{StaticResource SlimCellText}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <ui:Button Content="{Binding [Slim.MigrateSelected], Source={x:Static services:Locator.L10n}}"
                               Appearance="Danger" Command="{Binding MigrateSelectedCommand}"
                               HorizontalAlignment="Left" Margin="0,8,0,0"/>
                </StackPanel>
            </ui:Card>
            <!-- ④ 迁移记录卡:时间/源/目标/回退(未回退项显示回退按钮,已回退显示状态文案) -->
            <ui:Card Margin="0,4">
                <StackPanel Margin="16">
                    <TextBlock Text="{Binding [Slim.MigrateLog], Source={x:Static services:Locator.L10n}}"
                               FontWeight="SemiBold"/>
                    <DataGrid Style="{StaticResource SlimGrid}" ItemsSource="{Binding MigrationLog}" ScrollViewer.VerticalScrollBarVisibility="Auto"
                              MaxHeight="240" MinHeight="48" Margin="0,8,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{Binding [Tokens.Col.Time], Source={x:Static services:Locator.L10n}}"
                                                Binding="{Binding TimeText}" Width="*" MinWidth="110" ElementStyle="{StaticResource SlimCellText}"/>
                            <DataGridTextColumn Header="{Binding [Slim.Col.Source], Source={x:Static services:Locator.L10n}}"
                                                Binding="{Binding Source}" Width="2*" MinWidth="220" ElementStyle="{StaticResource SlimCellText}"/>
                            <DataGridTextColumn Header="{Binding [Slim.Col.Target], Source={x:Static services:Locator.L10n}}"
                                                Binding="{Binding Target}" Width="2*" MinWidth="220" ElementStyle="{StaticResource SlimCellText}"/>
                            <DataGridTemplateColumn Header="{Binding [Slim.Revert], Source={x:Static services:Locator.L10n}}"
                                                    Width="*" MinWidth="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <ui:Button Content="{Binding [Slim.Revert], Source={x:Static services:Locator.L10n}}"
                                                       Command="{Binding DataContext.RevertCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                       CommandParameter="{Binding}"
                                                       Visibility="{Binding Reverted, Converter={StaticResource InvBoolToVis}}"/>
                                            <TextBlock Text="{Binding RevertedText}" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       Visibility="{Binding Reverted, Converter={StaticResource BoolToVis}}"/>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="{Binding [Slim.MigrateLogEmpty], Source={x:Static services:Locator.L10n}}"
                               Visibility="{Binding HasMigrationLog, Converter={StaticResource InvBoolToVis}}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,8,0,0"/>
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</Page>
