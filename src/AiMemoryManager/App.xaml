<Application x:Class="AiMemoryManager.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:services="clr-namespace:AiMemoryManager.Services">
    <Application.Resources>
        <ResourceDictionary>
            <!-- FR-10.8：统一使用 Windows Fluent 字体，保留 Segoe UI 作为旧版系统回退。 -->
            <FontFamily x:Key="AppFontFamily">Segoe UI Variable, Segoe UI</FontFamily>
            <FontFamily x:Key="IconFontFamily">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
            <Style TargetType="{x:Type Page}">
                <Setter Property="services:AnimationBehavior.EnablePageFade" Value="True"/>
            </Style>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
