<ui:FluentWindow x:Class="AiMemoryManager.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:tb="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf"
    xmlns:views="clr-namespace:AiMemoryManager.Views"
    xmlns:services="clr-namespace:AiMemoryManager.Services"
    Title="{Binding [App.Title], Source={x:Static services:Locator.L10n}, FallbackValue=AI Memory Manager}"
    Width="1180" Height="760" MinWidth="900" MinHeight="560"
    ResizeMode="CanResize" SizeToContent="Manual"
    WindowBackdropType="Mica" ExtendsContentIntoTitleBar="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- 自定义标题栏:启用常规最小化/最大化(还原)/关闭按钮。 -->
        <ui:TitleBar Grid.Row="0"
                     Title="{Binding [App.Title], Source={x:Static services:Locator.L10n}}"
                     ShowMinimize="True" ShowMaximize="True" ShowClose="True"
                     CanMaximize="True"/>
        <Grid Grid.Row="1">
        <tb:TaskbarIcon x:Name="Tray" ToolTipText="AI Memory Manager" TrayMouseDoubleClick="OnTrayOpen">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="{Binding [Tray.Clean], Source={x:Static services:Locator.L10n}}" Click="OnTrayClean"/>
                    <MenuItem Header="{Binding [Tray.Open], Source={x:Static services:Locator.L10n}}" Click="OnTrayOpen"/>
                    <Separator/>
                    <MenuItem Header="{Binding [Tray.Exit], Source={x:Static services:Locator.L10n}}" Click="OnTrayExit"/>
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>
        <ui:NavigationView x:Name="RootNavigation" IsBackButtonVisible="Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="{Binding [Nav.Dashboard], Source={x:Static services:Locator.L10n}}"
                                       Tag="dashboard" TargetPageType="{x:Type views:DashboardPage}"
                                       Icon="{ui:SymbolIcon Home24}"/>
                <ui:NavigationViewItem Content="{Binding [Nav.Processes], Source={x:Static services:Locator.L10n}}"
                                       Tag="processes" TargetPageType="{x:Type views:ProcessesPage}"
                                       Icon="{ui:SymbolIcon AppsList24}"/>
                <ui:NavigationViewItem Content="{Binding [Nav.Rules], Source={x:Static services:Locator.L10n}}"
                                       Tag="rules" TargetPageType="{x:Type views:RulesPage}"
                                       Icon="{ui:SymbolIcon Timer24}"/>
                <ui:NavigationViewItem Content="{Binding [Nav.Analysis], Source={x:Static services:Locator.L10n}}"
                                       Tag="analysis" TargetPageType="{x:Type views:SmartAnalysisPage}"
                                       Icon="{ui:SymbolIcon Sparkle24}"/>
                <ui:NavigationViewItem Content="{Binding [Nav.Llm], Source={x:Static services:Locator.L10n}}"
                                       Tag="llm" TargetPageType="{x:Type views:LlmSettingsPage}"
                                       Icon="{ui:SymbolIcon Bot24}"/>
                <ui:NavigationViewItem Content="{Binding [Nav.CSlim], Source={x:Static services:Locator.L10n}}"
                                       Tag="cslim" TargetPageType="{x:Type views:CSlimPage}"
                                       Icon="{ui:SymbolIcon HardDrive24}"/>
                <ui:NavigationViewItem Content="{Binding [Nav.TokenStats], Source={x:Static services:Locator.L10n}}"
                                       Tag="tokens" TargetPageType="{x:Type views:TokenStatsPage}"
                                       Icon="{ui:SymbolIcon DataUsage24}"/>
                <ui:NavigationViewItem Content="{Binding [Nav.Whitelist], Source={x:Static services:Locator.L10n}}"
                                       Tag="whitelist" TargetPageType="{x:Type views:WhitelistPage}"
                                       Icon="{ui:SymbolIcon ShieldCheckmark24}"/>
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="{Binding [Nav.Settings], Source={x:Static services:Locator.L10n}}"
                                       Tag="settings" TargetPageType="{x:Type views:SettingsPage}"
                                       Icon="{ui:SymbolIcon Settings24}"/>
            </ui:NavigationView.FooterMenuItems>
        </ui:NavigationView>
        </Grid>
    </Grid>
</ui:FluentWindow>
